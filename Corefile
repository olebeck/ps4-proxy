# bypass proxy example
agent-*.ww.np.playstation.net:53 {
    forward . 1.1.1.1 9.9.9.9
    cache 300
}

playstation.net:53 {
    template IN A {
        match ".*"
        answer "{{ .Name }} 60 IN A YOURPCIP"
    }
    template IN AAAA {
        match ".*"
        rcode NOERROR
    }
}

.:53 {
    forward . 1.1.1.1 9.9.9.9
    cache 300
}